                "description": "The identifier (UUID) of the resource."
              }
            ]
          },
          "docs": "Update a policy"
        },
        {
          "info": {
            "name": "Delete a policy",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.keygen.sh/v1/accounts/{account}/policies/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The identifier (UUID) of the resource."
              }
            ]
          },
          "docs": "Delete a policy"
        }
      ]
    }
  ],
  "bundled": true
