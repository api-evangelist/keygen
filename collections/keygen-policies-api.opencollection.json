          "info": {
            "name": "List all policies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.keygen.sh/v1/accounts/{account}/policies"
          },
          "docs": "List all policies"
        },
        {
          "info": {
            "name": "Create a policy",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.keygen.sh/v1/accounts/{account}/policies",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a policy"
        },
        {
          "info": {
            "name": "Retrieve a policy",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.keygen.sh/v1/accounts/{account}/policies/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The identifier (UUID) of the resource."
              }
            ]
          },
          "docs": "Retrieve a policy"
        },
        {
          "info": {
            "name": "Update a policy",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.keygen.sh/v1/accounts/{account}/policies/:id",
