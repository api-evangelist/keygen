{
  "opencollection": "1.0.0",
  "info": {
    "name": "Keygen Artifacts Components API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Components",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List a machine's components",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.keygen.sh/v1/accounts/{account}/machines/:id/components",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The identifier (UUID) of the resource."
              }
            ]
          },
          "docs": "List a machine's components"
        },
        {
          "info": {
            "name": "List all components",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.keygen.sh/v1/accounts/{account}/components"
          },
          "docs": "List all components"
        },
        {
          "info": {
            "name": "Create a component",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.keygen.sh/v1/accounts/{account}/components",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a component"
        }
      ]
    }
  ],
  "bundled": true
}